# GEMINI_API_KEY: Required for server-side Gemini AI news bulletins, classification, and daily briefings.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The canonical URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEWS_API_KEY: Optional API key for NewsAPI.org integration (https://newsapi.org).
# When provided, enables the NewsAPI adapter alongside live RSS and GDELT providers.
NEWS_API_KEY="YOUR_NEWSAPI_ORG_KEY"

# GDELT_API_BASE_URL: Base endpoint for GDELT 2.0 Document API (no key required).
GDELT_API_BASE_URL="https://api.gdeltproject.org/api/v2/doc/doc"

# ADMIN_EMAIL: Optional administrator email address for automatic admin role assignment upon Google Sign-In.
ADMIN_EMAIL="admin@example.com"

# NOTIFICATION_WEBHOOK_URL: Optional webhook endpoint for dispatching high-priority breaking news alerts.
NOTIFICATION_WEBHOOK_URL=""
